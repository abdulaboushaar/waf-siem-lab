# waf/pl2.env
# Paranoia level ONLY. Everything else lives in common.env.
#
# VERSION-SPECIFIC, VERIFY: the current coreruleset/modsecurity-crs image reads
# BLOCKING_PARANOIA (default 1). Older images and many tutorials use PARANOIA.
# Confirm the name for your pinned tag before trusting a run:
#   docker exec lab-waf sh -c 'grep -ri paranoia /etc/modsecurity.d/ | head'
BLOCKING_PARANOIA=2

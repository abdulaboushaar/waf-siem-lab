# waf/common.env
# Shared WAF configuration for EVERY paranoia level. The pl*.env files set only
# the paranoia level, so the four measurement runs differ in exactly one
# variable. Verify each name below against the README of your PINNED image tag:
#   docker exec lab-waf env | sort        (see what the image actually reads)

# REQUIRED. Where the WAF forwards traffic it allows through. The app container
# listens on port 80 inside the compose network.
BACKEND=http://app:80

# Rule engine (SecRuleEngine). DetectionOnly = inspect and score, never block.
# This is the baseline. Switch to On to actually enforce blocking once you have
# looked at the false positives DetectionOnly reveals.
MODSEC_RULE_ENGINE=On

# Audit engine (SecAuditEngine). RelevantOnly logs only transactions that
# tripped a rule or returned a relevant status, which is exactly the events we
# want to correlate. On would log all 150 requests; Off would log nothing.
MODSEC_AUDIT_ENGINE=RelevantOnly
MODSEC_AUDIT_LOG=/var/log/modsec/modsec_audit.log
MODSEC_AUDIT_LOG_FORMAT=JSON
MODSEC_AUDIT_LOG_TYPE=Serial
# ABIJDEFHZ is the image default. Part B carries the request headers, which is
# where X-Lab-Request-Id appears, so the normalizer can recover the correlation
# id from the audit log.
MODSEC_AUDIT_LOG_PARTS=ABIJDEFHZ

# CRS anomaly scoring thresholds. When the rule engine is On, a request is
# blocked once its inbound anomaly score reaches ANOMALY_INBOUND. 5 means a
# single CRITICAL-severity rule match is enough on its own.
ANOMALY_INBOUND=5
ANOMALY_OUTBOUND=4

# Inspect request bodies so POST payloads (login, comment) are scored, not just
# the query string.
MODSEC_REQ_BODY_ACCESS=on
